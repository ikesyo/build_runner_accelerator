{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  // Dependabot maintains the actions.lock entries, so it keeps GitHub
  // Actions updates.
  'github-actions': {
    enabled: false,
  },
  packageRules: [
    {
      description: 'Group OpenTelemetry crates',
      matchManagers: ['cargo'],
      matchPackageNames: [
        'opentelemetry',
        'opentelemetry_sdk',
        'opentelemetry-proto',
      ],
      groupName: 'opentelemetry',
    },
  ],
}
