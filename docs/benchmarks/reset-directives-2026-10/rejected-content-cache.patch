diff --git a/lib/src/reset_directives.dart b/lib/src/reset_directives.dart
new file mode 100644
--- /dev/null
+++ b/lib/src/reset_directives.dart
@@ -0,0 +1,58 @@
+import 'dart:collection';
+
+/// Reuses only the pure reset extraction, keyed by the entire immutable string.
+/// String equality verifies content even on hash collisions. Asset identity,
+/// mutable bytes, mtime and AssetContent's optionally inherited digest are not
+/// validity keys. Clear at build start; eviction only causes another extraction.
+final class ResetDirectiveCache {
+  ResetDirectiveCache({this.maxEntries = 128, this.maxCodeUnits = 1024 * 1024});
+
+  final int maxEntries;
+  final int maxCodeUnits;
+  final _entries = LinkedHashMap<String, Set<String>>();
+  int _codeUnits = 0;
+
+  static final pattern = RegExp(
+    r'''^\s*(?:import|export|part(?:\s+of)?|library)\s[^;]*;''',
+    multiLine: true,
+  );
+
+  int get retainedEntries => _entries.length;
+  int get retainedCodeUnits => _codeUnits;
+
+  Set<String>? lookup(String content) {
+    final value = _entries.remove(content);
+    if (value != null) _entries[content] = value;
+    return value;
+  }
+
+  Set<String> extract(String content) {
+    final hit = lookup(content);
+    if (hit != null) return hit;
+    final result = Set<String>.unmodifiable(
+      pattern.allMatches(content).map((match) => match.group(0)!.trim()),
+    );
+    return store(content, result);
+  }
+
+  Set<String> store(String content, Set<String> directives) {
+    final immutable = Set<String>.unmodifiable(directives);
+    if (maxEntries <= 0 || content.length > maxCodeUnits) return immutable;
+    if (_entries.remove(content) != null) _codeUnits -= content.length;
+    while (_entries.isNotEmpty &&
+        (_entries.length >= maxEntries ||
+            _codeUnits + content.length > maxCodeUnits)) {
+      final oldest = _entries.keys.first;
+      _entries.remove(oldest);
+      _codeUnits -= oldest.length;
+    }
+    _entries[content] = immutable;
+    _codeUnits += content.length;
+    return immutable;
+  }
+
+  void clear() {
+    _entries.clear();
+    _codeUnits = 0;
+  }
+}
diff --git a/test/reset_directives_cache_test.dart b/test/reset_directives_cache_test.dart
new file mode 100644
--- /dev/null
+++ b/test/reset_directives_cache_test.dart
@@ -0,0 +1,107 @@
+import 'dart:convert';
+import 'dart:math';
+import 'dart:typed_data';
+
+import 'package:build_runner/src/build/asset_content.dart';
+import 'package:build_runner_accelerator/src/reset_directives.dart';
+import 'package:test/test.dart';
+
+final legacy = RegExp(
+  r'''^\s*(?:import|export|part(?:\s+of)?|library)\s[^;]*;''',
+  multiLine: true,
+);
+Set<String> reference(String content) =>
+    legacy.allMatches(content).map((match) => match.group(0)!.trim()).toSet();
+
+void main() {
+  test('exact legacy extraction, including malformed and late text', () {
+    final cache = ResetDirectiveCache();
+    final cases = [
+      '',
+      "import 'a.dart';\nclass A {}",
+      "// @dart=3.11\nlibrary example;\npart 'a.dart';\npart of example;",
+      "import\n 'a.dart'\n if (dart.library.io) 'b.dart';\nexport 'c.dart' show C;",
+      "/* comment */\nimport 'a.dart';\n// import 'ignored.dart';",
+      "class A {}\nimport 'late.dart';\npart of 'parent.dart';",
+      "final text = '''\nimport 'string.dart';\n''';\n/*\nexport 'comment.dart';\n*/",
+      "import 'unterminated\npart 'later.dart';",
+      "\r\n\t library foo;\u2028part of foo;\u2029export 'x.dart';",
+      "import 'a; b.dart';\npart\nof foo;\nimport'';",
+      'library;\npart of;\nlibrary example\nclass A {}',
+    ];
+    for (final content in cases) {
+      expect(cache.extract(content), reference(content), reason: content);
+      expect(
+        cache.extract(content),
+        reference(content),
+        reason: 'hit: $content',
+      );
+    }
+    final random = Random(92);
+    for (var i = 0; i < 300; i++) {
+      final content = List.generate(
+        1 + random.nextInt(8),
+        (_) => cases[random.nextInt(cases.length)],
+      ).join(random.nextBool() ? '\n' : ' ');
+      expect(cache.extract(content), reference(content));
+      expect(cache.extract(content), reference(content));
+    }
+  });
+
+  test(
+    'immutable decoded content, not asset, mutable bytes or inherited digest',
+    () {
+      final cache = ResetDirectiveCache();
+      final bytes = Uint8List.fromList(utf8.encode("import 'a.dart';"));
+      final first = AssetContent.bytes(bytes);
+      final digest = first.digest;
+      final a = cache.extract(first.stringValue());
+      final same = AssetContent.bytes(utf8.encode("import 'a.dart';"));
+      expect(identical(cache.extract(same.stringValue()), a), isTrue);
+      bytes[8] = 'b'.codeUnitAt(0);
+      final changed = AssetContent.bytes(bytes, digest: digest);
+      expect(changed.digest, digest);
+      expect(cache.extract(changed.stringValue()), {"import 'b.dart';"});
+      expect(cache.extract(first.stringValue()), {"import 'a.dart';"});
+      expect(() => a.add("export 'stale.dart';"), throwsUnsupportedError);
+    },
+  );
+
+  test(
+    'body edits miss, equal text reuses across resets, clear starts a new build',
+    () {
+      final cache = ResetDirectiveCache();
+      final first = cache.extract("part of app;\nclass A {}");
+      final edited = cache.extract("part of app;\nclass B {}");
+      expect(edited, first);
+      expect(identical(edited, first), isFalse);
+      expect(cache.extract("part of other;\nclass B {}"), isNot(first));
+      expect(
+        identical(cache.extract("part of app;\nclass A {}"), first),
+        isTrue,
+      );
+      cache.clear();
+      expect(cache.retainedEntries, 0);
+      expect(cache.retainedCodeUnits, 0);
+      expect(
+        identical(cache.extract("part of app;\nclass A {}"), first),
+        isFalse,
+      );
+    },
+  );
+
+  test('LRU and byte budget only change extraction frequency', () {
+    final cache = ResetDirectiveCache(maxEntries: 2, maxCodeUnits: 40);
+    final a = cache.extract("import 'a.dart';");
+    final b = cache.extract("import 'b.dart';");
+    expect(identical(cache.extract("import 'a.dart';"), a), isTrue);
+    cache.extract("import 'c.dart';");
+    expect(cache.retainedEntries, 2);
+    expect(cache.retainedCodeUnits, 32);
+    expect(identical(cache.extract("import 'b.dart';"), b), isFalse);
+    final oversized = "import 'large.dart';${' ' * 50}";
+    expect(cache.extract(oversized), reference(oversized));
+    expect(cache.lookup(oversized), isNull);
+    expect(cache.retainedCodeUnits, lessThanOrEqualTo(40));
+  });
+}
diff --git a/tool/benchmark_reset_directives_cache.dart b/tool/benchmark_reset_directives_cache.dart
new file mode 100644
--- /dev/null
+++ b/tool/benchmark_reset_directives_cache.dart
@@ -0,0 +1,53 @@
+import 'dart:io';
+
+import 'package:build_runner_accelerator/src/reset_directives.dart';
+
+/// AOT compile, then supply a directory containing the measured Dart outputs.
+/// Isolates cold misses/within-reset equal-content hits; not a build benchmark.
+void main(List<String> arguments) {
+  List<String> readContents() => Directory(arguments.single)
+      .listSync(recursive: true)
+      .whereType<File>()
+      .where(
+        (file) => file.path.endsWith('.dart') || file.path.endsWith('.part'),
+      )
+      .map((file) => file.readAsStringSync())
+      .toList();
+  print('repeat,lane,elapsed_us,files,code_units,entries,retained_code_units');
+  for (var repeat = 0; repeat < 7; repeat++) {
+    for (final lane
+        in repeat.isEven
+            ? ['baseline', 'candidate']
+            : ['candidate', 'baseline']) {
+      final contents = readContents();
+      final cache = ResetDirectiveCache();
+      final results = <Set<String>>[];
+      final watch = Stopwatch()..start();
+      for (final content in contents) {
+        final result = lane == 'candidate'
+            ? cache.extract(content)
+            : ResetDirectiveCache.pattern
+                  .allMatches(content)
+                  .map((match) => match.group(0)!.trim())
+                  .toSet();
+        results.add(result);
+      }
+      watch.stop();
+      for (var i = 0; i < contents.length; i++) {
+        final reference = ResetDirectiveCache.pattern
+            .allMatches(contents[i])
+            .map((match) => match.group(0)!.trim())
+            .toSet();
+        if (results[i].length != reference.length ||
+            !results[i].containsAll(reference)) {
+          throw StateError('Different extraction');
+        }
+      }
+      print(
+        '$repeat,$lane,${watch.elapsedMicroseconds},${contents.length},'
+        '${contents.fold<int>(0, (sum, text) => sum + text.length)},'
+        '${cache.retainedEntries},${cache.retainedCodeUnits}',
+      );
+    }
+  }
+}
