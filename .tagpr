# tagpr configuration for the single-package release flow.
[tagpr]
    releaseBranch = main
    # Keep pubspec.yaml first: tagpr uses the first file to determine the tag.
    versionFile = pubspec.yaml,lib/src/launcher.dart,rust/Cargo.toml
    # Keep Cargo.lock in sync after tagpr bumps Cargo.toml.
    postVersionCommand = cargo metadata --manifest-path rust/Cargo.toml --format-version 1 --no-deps >/dev/null
    vPrefix = true
    changelog = true
    changelogFile = CHANGELOG.md
    releaseYAMLPath = .github/release.yml
    # The release workflow attaches signed native artifacts before publishing.
    release = false
